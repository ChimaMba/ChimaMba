# ---- Claude ----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ---- Google / Gmail ----
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Application type: "Desktop app" is easiest for a self-hosted tool.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
# Must exactly match an Authorized redirect URI on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth/callback

# ---- App ----
PORT=8787
# Public base URL. Used to build unsubscribe links, so it must be reachable
# by your recipients. For local-only use, leave as localhost and accept that
# unsubscribe links only work on your machine.
PUBLIC_BASE_URL=http://localhost:8787

# Random string. Signs unsubscribe tokens and protects the dashboard.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me

# Password for the dashboard. Leave blank to disable auth (localhost only!).
DASHBOARD_PASSWORD=

# Your own address — the account the agent reads and sends from.
OWNER_EMAIL=chima.nuel.mba@gmail.com
OWNER_NAME=Chima Mba

# CAN-SPAM requires a real physical postal address in commercial email.
# This is appended to every outreach email.
POSTAL_ADDRESS=

# How often to poll the inbox, in seconds.
POLL_INTERVAL_SECONDS=120
