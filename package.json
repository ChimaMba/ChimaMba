{
  "name": "inbox-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Automated client email agent: triages inbound mail, drafts replies, auto-sends the safe ones, and runs outreach campaigns.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "auth": "tsx src/scripts/auth.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "tsx src/scripts/check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
